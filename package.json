{
  "name": "bic-library-search",
  "version": "1.0.0",
  "homepage": "https://github.com/ByItsCover/bic-library-search#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ByItsCover/bic-library-search.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild `find src \\( -name '*.ts' \\)` --bundle --minify --platform=node --target=esnext --outdir=dist --external:@lancedb/lancedb"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.161",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@apollo/client": "^4.2.0",
    "@aws-lambda-powertools/event-handler": "^2.32.0",
    "@aws-lambda-powertools/logger": "^2.32.0",
    "@aws-lambda-powertools/parameters": "^2.33.1",
    "@aws-sdk/client-secrets-manager": "^3.1053.0",
    "@aws-sdk/client-sqs": "^3.1069.0",
    "@huggingface/transformers": "4.0.1",
    "@lancedb/lancedb": "^0.27.1",
    "adm-zip": "^0.6.0",
    "aws-jwt-verify": "^5.2.1",
    "aws-lambda-ric": "^4.0.2",
    "brace-expansion": "^5.0.8",
    "gliner": "^0.0.19",
    "glob": "^13.0.6",
    "onnxruntime-node": "^1.19.2",
    "sharp": "^0.35.3",
    "tar": "^7.5.22",
    "uuid": "^14.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "aws-lambda-ric@4.0.2": true
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "@xenova/transformers": "npm:@huggingface/transformers@4.0.1",
    "adm-zip": "^0.6.0",
    "sharp": "^0.35.3"
